# ── Requeridas ─────────────────────────────────────────────────────────────────

# Token de aplicación de la API de GLPI
GLPI_APP_TOKEN=

# Token de usuario de la API de GLPI
GLPI_USER_TOKEN=

# Clave interna para proteger los endpoints (generá una con: openssl rand -hex 32)
API_KEY=

# ── Opcionales (ya tienen valores por defecto) ──────────────────────────────────

# URL base de GLPI (sin barra al final)
# GLPI_BASE_URL=https://glpi.akron.com.ar

# Puerto en el que escucha el backend
# PORT=3000

# Tiempo de vida de la sesión GLPI en segundos (por defecto 8 horas)
# SESSION_MAX_AGE_SEC=28800

# Timeout de requests a GLPI en segundos
# GLPI_TIMEOUT_SEC=30

# TTL del caché de modelos de consumibles en segundos (por defecto 10 minutos)
# MODEL_CACHE_TTL_SEC=600
